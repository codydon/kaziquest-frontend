# Nuxt runtime config environment variables
# Public variables are exposed to the client.

# Public URL used for OG metadata and canonical links.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Application environment label used by app-level feature checks.
NUXT_PUBLIC_CURRENT_ENVIRONMENT=development

# Backend API base URL (include /api when required by backend routing).
NUXT_PUBLIC_API_BASE=http://localhost:8888/api

# Main app origin used for cross-subdomain redirects.
NUXT_PUBLIC_MAIN_APP_URL=http://app.kaziquest.test

# Comma-separated list of subdomains excluded from tenant routing logic.
NUXT_PUBLIC_EXCLUDED_SUBDOMAINS=app,beta-test,alpha-test,jobs

# Feature flags
NUXT_PUBLIC_USE_MOCK_PAYMENTS=false

# Optional observability DSN for browser SDKs.
NUXT_PUBLIC_SENTRY_DSN=

# Server-only values (never exposed to the client)
NUXT_API_SECRET=

# Legacy migration note:
# BACKEND_URL, MAIN_APP_URL, EXCLUDED_SUBDOMAINS, and SENTRY_DSN are still read
# as fallbacks, but new deployments should use the NUXT_* names above.
